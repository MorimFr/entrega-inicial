        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "room_id": {
            "type": "string",
            "title": "Room Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "title": "Starts At"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
